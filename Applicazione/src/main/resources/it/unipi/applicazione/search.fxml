<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style/list.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.applicazione.SearchController">
    <top>
        <Label styleClass="title-label" text="Cerca" BorderPane.alignment="CENTER">
        <BorderPane.margin>
            <Insets bottom="15.0" top="15.0" />
        </BorderPane.margin>
        </Label>
   </top>
   <center>
        <TableView fx:id="searchTable" BorderPane.alignment="CENTER">
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#addToFavorites" text="Aggiungi ai preferiti" />
                        <MenuItem mnemonicParsing="false" onAction="#removeFromFavorites" text="Rimuovi dai preferiti" />
                    </items>
                </ContextMenu>
            </contextMenu>
        </TableView>
   </center>
   <bottom>
        <HBox alignment="TOP_CENTER" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox>
                            <children>
                                <Label text="Prezzo minimo">
                            <HBox.margin>
                                <Insets left="10.0" right="20.0" />
                            </HBox.margin></Label>
                                <TextField fx:id="minPriceField" />
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="Prezzo massimo">
                            <HBox.margin>
                                <Insets left="10.0" right="10.0" />
                            </HBox.margin></Label>
                                <TextField fx:id="maxPriceField" />
                            </children>
                        </HBox>
                    </children>
                    <HBox.margin>
                        <Insets right="50.0" />
                    </HBox.margin>
                </VBox>
                <VBox alignment="TOP_CENTER">
                    <children>
                        <Label text="Variazione 24h positiva">
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>
                        <CheckBox fx:id="positiveChangeButton" />
                    </children>
                    <HBox.margin>
                        <Insets right="30.0" top="15.0" />
                    </HBox.margin>
                </VBox>
                <Button fx:id="applyButton" onAction="#searchCrypto" text="Applica">
                    <HBox.margin>
                        <Insets right="25.0" top="17.0" />
                    </HBox.margin>
                </Button>
                <Button onAction="#switchToMain" text="Pagina principale">
                    <HBox.margin>
                        <Insets right="10.0" top="17.0" />
                    </HBox.margin>
                </Button>
            </children>
            <BorderPane.margin>
                <Insets bottom="15.0" top="15.0" />
            </BorderPane.margin>
        </HBox>
    </bottom>
</BorderPane>
