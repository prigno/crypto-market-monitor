<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@style/main.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.applicazione.MainController">
   <center>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="title" text="Crypto Tracker" />
                <Label styleClass="subtitle" text="Monitora e gestisci le criptovalute con CoinGecko" />
                <HBox alignment="TOP_CENTER" spacing="25.0">
                    <children>
                    <Button fx:id="updateButton" mnemonicParsing="false" onAction="#update" styleClass="primary-button" text="Aggiorna" />
                        <Button fx:id="searchButton" onAction="#showSearch" styleClass="primary-button" text="Cerca" />
                        <Button onAction="#showFavorites" styleClass="primary-button" text="Preferiti" />
                    </children>
                    <padding>
                        <Insets top="75.0" />
                    </padding>
                </HBox>
                <VBox alignment="TOP_CENTER">
                    <children>     
                        <Button fx:id="initButton" onAction="#inizializza" styleClass="secondary-button" text="Inizializza il sistema" />
                        <Label fx:id="statusLabel" styleClass="status" />
                    </children>
                    <padding>
                        <Insets top="25.0" />
                    </padding>
                </VBox>
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
        </VBox>
   </center>
</BorderPane>
