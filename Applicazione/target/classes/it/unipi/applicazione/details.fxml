<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" pannable="true" stylesheets="@style/details.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.applicazione.DetailsController">

    <content>
        <VBox>
           <children>   
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Name: " />
                        <Label fx:id="nameLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>   
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Symbol: " />
                        <Label fx:id="symbolLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Market Cap Rank: " />
                        <Label fx:id="rankLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Homepage: " />
                        <Hyperlink fx:id="homepageLink" onAction="#openInBrowser" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <Label styleClass="static-label" text="Description:" />
               <TextArea fx:id="descriptionArea" editable="false" wrapText="true" />
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Current price (EUR): " />
                        <Label fx:id="priceLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="Market cap (EUR): " />
                        <Label fx:id="marketCapLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <HBox>
                    <children>
                        <Label styleClass="static-label" text="ATH (EUR): " />
                        <Label fx:id="athLabel" styleClass="dynamic-label" />
                        <Label styleClass="static-label" text="ATH date: " />
                        <Label fx:id="athDateLabel" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <HBox>
                    <children>
                      <Label styleClass="static-label" text="High 24h: " />
                      <Label fx:id="high24Label" styleClass="dynamic-label" />
                      <Label styleClass="static-label" text="Low 24h: " />
                      <Label fx:id="low24Label" styleClass="dynamic-label" />
                    </children>
               </HBox>
               <VBox>
                    <children>
                        <Label styleClass="static-label" text="Price change:" />
                        <GridPane hgap="10" vgap="5">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                                <ColumnConstraints prefWidth="80" />
                            </columnConstraints>
                        <children>         
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="24h" GridPane.columnIndex="1" />
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="7d" GridPane.columnIndex="2" />
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="14d" GridPane.columnIndex="3" />
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="30d" GridPane.columnIndex="4" />
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="60d" GridPane.columnIndex="5" />
                            <Label alignment="CENTER" styleClass="static-label" text="200d" GridPane.columnIndex="6" />
                            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="static-label" text="1y" GridPane.columnIndex="7" />     
                            <Label contentDisplay="CENTER" styleClass="static-label" text="\%" GridPane.rowIndex="1" />         
                            <Label fx:id="p24Label" styleClass="dynamic-label" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label fx:id="p7Label" styleClass="dynamic-label" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Label fx:id="p14Label" styleClass="dynamic-label" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            <Label fx:id="p30Label" styleClass="dynamic-label" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                            <Label fx:id="p60Label" styleClass="dynamic-label" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                            <Label fx:id="p200Label" styleClass="dynamic-label" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                            <Label fx:id="p1Label" styleClass="dynamic-label" GridPane.columnIndex="7" GridPane.rowIndex="1" />
                        </children>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                        </GridPane>
                    </children>
                </VBox>
                <LineChart fx:id="priceChart" title="Price change">
                    <xAxis>
                        <NumberAxis label="Date" side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Price (EUR)" side="LEFT" />
                    </yAxis>
                <VBox.margin>
                    <Insets right="15.0" />
                </VBox.margin>
                </LineChart>
                <HBox styleClass="last-hbox">
                    <children>
                        <RadioButton fx:id="month1Button" onAction="#reloadChart" text="1 month">
                            <toggleGroup>
                                <ToggleGroup fx:id="months" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="month3Button" onAction="#reloadChart" selected="true" text="3 months" toggleGroup="$months" />
                        <RadioButton fx:id="month6Button" onAction="#reloadChart" text="6 months" toggleGroup="$months" />
                        <RadioButton fx:id="month12Button" onAction="#reloadChart" text="12 months" toggleGroup="$months" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </content>
   <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</ScrollPane>
